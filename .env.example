# Perfil prod (Neon). O perfil dev não lê este arquivo.
# Converta a connection string do Neon:
# postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
# vira a URL JDBC abaixo, com usuário e senha separados.
# Se a senha tiver caracteres especiais, use o valor decodificado, sem encoding de URL.

SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://SEU_HOST.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=
AUTH_USERNAME=avaliador
AUTH_PASSWORD=troque-esta-senha
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
JWT_EXPIRATION_MINUTES=120
CORS_ORIGINS=http://localhost:5173
